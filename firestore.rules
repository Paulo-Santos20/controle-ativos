rules_version = '2';
service cloud.firestore {

  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════════
    // FUNÇÕES AUXILIARES
    // ═══════════════════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin_geral' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gestor');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMasterEmail() {
      return isAuthenticated() &&
        request.auth.token.email == 'paulo.santos@hospitalregionaldocerrado.com.br';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserAssignedUnits() {
      let userData = getUserData();
      let allowedUnits = userData.assignedUnits;
      return allowedUnits != null ? allowedUnits : [];
    }

    function canAccessAssetUnit(unitId) {
      return (isAdmin() || isMasterEmail()) ||
             (unitId == null || unitId == '') ||
             getUserAssignedUnits().hasAny([unitId]);
    }

    function isValidUnit(unitId) {
      return (unitId == null || unitId == '') ||
             getUserAssignedUnits().hasAny([unitId]);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: users
    // ═══════════════════════════════════════════════════════════════════════════

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isMasterEmail();
      allow create: if isAdmin() || isMasterEmail() || request.resource.data._createdBy == 'self_register';
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'assignedUnits']);
      allow update, delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: users/{userId}/profiles
    // ═══════════════════════════════════════════════════════════════════════════

    match /users/{userId}/profiles/{profileId} {
      allow read, write: if isOwner(userId) || isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: users/{userId}/sessions
    // ═══════════════════════════════════════════════════════════════════════════

    match /users/{userId}/sessions/{sessionId} {
      allow read: if isOwner(userId) || isAdmin() || isMasterEmail();
      allow write: if isOwner(userId);
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: roles
    // ═══════════════════════════════════════════════════════════════════════════

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: units
    // ═══════════════════════════════════════════════════════════════════════════

    match /units/{unitId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isMasterEmail() ||
        (getUserAssignedUnits() != null && getUserAssignedUnits().hasAny([unitId]))
      );
      allow create: if isAdmin() || isMasterEmail();
      allow update, delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: assets
    // ═══════════════════════════════════════════════════════════════════════════

    match /assets/{assetId} {
      allow read: if isAuthenticated() && canAccessAssetUnit(resource.data.unitId);
      allow create: if isAuthenticated() && (
        isAdmin() || isMasterEmail() ||
        request.resource.data.unitId == null ||
        request.resource.data.unitId == '' ||
        isValidUnit(request.resource.data.unitId)
      );
      allow update: if isAuthenticated() && canAccessAssetUnit(resource.data.unitId);
      allow delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: assets/{assetId}/history
    // ═══════════════════════════════════════════════════════════════════════════

    match /assets/{assetId}/history/{historyId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isMasterEmail() ||
        canAccessAssetUnit(get(/databases/$(database)/documents/assets/$(assetId)).data.unitId)
      );
      allow create: if isAuthenticated() && (
        isAdmin() || isMasterEmail() ||
        isValidUnit(request.resource.data.unitId)
      );
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: suppliers
    // ═══════════════════════════════════════════════════════════════════════════

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: systemOptions
    // ═══════════════════════════════════════════════════════════════════════════

    match /systemOptions/{optionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: system_logs/audit/history
    // ═══════════════════════════════════════════════════════════════════════════

    match /system_logs/audit/history/{logId} {
      allow read: if isAdmin() || isMasterEmail();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: activity_logs
    // ═══════════════════════════════════════════════════════════════════════════

    match /activity_logs/{logId} {
      allow read: if isAdmin() || isMasterEmail();
      allow create: if isAdmin() || isMasterEmail();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: notification_logs
    // ═══════════════════════════════════════════════════════════════════════════

    match /notification_logs/{logId} {
      allow read: if isAdmin() || isMasterEmail();
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: push_tokens
    // ═══════════════════════════════════════════════════════════════════════════

    match /push_tokens/{tokenId} {
      allow read, write: if isOwner(resource.data.userId) || isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: settings
    // ═══════════════════════════════════════════════════════════════════════════

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: config
    // ═══════════════════════════════════════════════════════════════════════════

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: pin_reset_requests
    // ═══════════════════════════════════════════════════════════════════════════

    match /pin_reset_requests/{requestId} {
      allow read: if isAdmin() || isMasterEmail();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: support_tickets
    // ═══════════════════════════════════════════════════════════════════════════

    match /support_tickets/{ticketId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || isMasterEmail();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: user_progress
    // ═══════════════════════════════════════════════════════════════════════════

    match /user_progress/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isMasterEmail();
      allow write: if isOwner(userId) || isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: subscriptions
    // ═══════════════════════════════════════════════════════════════════════════

    match /subscriptions/{subId} {
      allow read: if isOwner(resource.data.userId) || isAdmin() || isMasterEmail();
      allow create, update, delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // COLLECTION: content_ratings
    // ═══════════════════════════════════════════════════════════════════════════

    match /content_ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || isMasterEmail();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // FALLBACK: nega tudo que não foi coberto acima
    // ═══════════════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if isAdmin() || isMasterEmail();
    }
  }
}