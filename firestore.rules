rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // 1. FUNÇÕES AUXILIARES
    // =================================================================

    function isLoggedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(currentUid())).data;
    }

    function userRole() {
      return userData().role;
    }

    function userAssignedUnits() {
      return userData().assignedUnits;
    }

    function isAdmin() {
      let role = userRole();
      return role == 'admin_geral' || role == 'gestor';
    }

    function isOwner(userId) {
      return currentUid() == userId;
    }

    function hasUnit(unitId) {
      return unitId in (userAssignedUnits() || []);
    }

    function hasRolePermission(module, action) {
      let roleId = userRole();
      if (roleId == null) return false;

      let roleDoc = get(/databases/$(database)/documents/roles/$(roleId));
      if (!roleDoc.exists) return false;

      let perms = roleDoc.data.permissions;
      if (perms == null) return false;

      let modulePerms = perms[module];
      if (modulePerms == null) return false;

      return modulePerms[action] == true;
    }

    // =================================================================
    // 2. USERS
    // =================================================================
    match /users/{userId} {
      allow create: if isLoggedIn();

      allow read: if isLoggedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        hasRolePermission('usuarios', 'read')
      );

      allow update: if isLoggedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        hasRolePermission('usuarios', 'update')
      );

      allow delete: if isLoggedIn() && isAdmin();

      match /sessions/{sessionId} {
        allow read, write, delete: if isLoggedIn() && isOwner(userId);
      }
    }

    // =================================================================
    // 3. ROLES (Perfis de Permissão)
    // =================================================================
    match /roles/{roleId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && isAdmin();
    }

    // =================================================================
    // 4. ASSETS (Ativos)
    // =================================================================
    match /assets/{assetId} {
      allow read: if isLoggedIn() && (
        isAdmin() ||
        (hasRolePermission('ativos', 'read') && hasUnit(resource.data.unitId))
      );

      allow create: if isLoggedIn() && (
        isAdmin() ||
        (hasRolePermission('ativos', 'create') && hasUnit(request.resource.data.unitId))
      );

      allow update: if isLoggedIn() && (
        isAdmin() ||
        (hasRolePermission('ativos', 'update') && hasUnit(resource.data.unitId))
      );

      allow delete: if isLoggedIn() && isAdmin();

      match /history/{historyId} {
        allow read: if isLoggedIn() && (
          isAdmin() ||
          (hasRolePermission('ativos', 'read') && hasUnit(get(/databases/$(database)/documents/assets/$(assetId)).data.unitId))
        );
        allow create: if isLoggedIn() && (
          isAdmin() ||
          (hasRolePermission('ativos', 'update') && hasUnit(get(/databases/$(database)/documents/assets/$(assetId)).data.unitId))
        );
      }
    }

    // =================================================================
    // 5. UNITS (Unidades)
    // =================================================================
    match /units/{unitId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_unidades', 'create')
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_unidades', 'update')
      );
      allow delete: if isLoggedIn() && isAdmin();
    }

    // =================================================================
    // 6. ASSET MODELS (Modelos de Computadores/Impressoras)
    // =================================================================
    match /assetModels/{modelId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_modelos', 'create')
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_modelos', 'update')
      );
      allow delete: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_modelos', 'delete')
      );
    }

    // =================================================================
    // 7. SUPPLIERS (Empresas/Fornecedores)
    // =================================================================
    match /suppliers/{supplierId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_empresas', 'create')
      );
      allow update: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_empresas', 'update')
      );
      allow delete: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_empresas', 'delete')
      );
    }

    // =================================================================
    // 8. SYSTEM OPTIONS (Opções do Sistema)
    // =================================================================
    match /systemOptions/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('cadastros_opcoes', 'update') ||
        hasRolePermission('cadastros_opcoes', 'create')
      );
    }

    // =================================================================
    // 9. SYSTEM LOGS (Logs de Auditoria)
    // =================================================================
    match /system_logs/{logType}/{docId} {
      allow read: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('usuarios', 'read')
      );
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && isAdmin();
    }

    // =================================================================
    // 10. DASHBOARD & MONITORING
    // =================================================================
    match /dashboard/{anything} {
      allow read: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('dashboard', 'read')
      );
    }

    match /monitoring/{anything} {
      allow read: if isLoggedIn() && (
        isAdmin() ||
        hasRolePermission('monitoramento', 'read')
      );
    }
  }
}