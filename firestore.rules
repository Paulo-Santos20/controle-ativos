rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =================================================================
    // 1. FUNÇÕES AUXILIARES
    // =================================================================

    function isLoggedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let role = getUserData().role;
      return role == 'admin_geral' || role == 'Admin_geral' || role == 'ADMIN_GERAL' ||
             role == 'gestor' || role == 'Gestor' || role == 'GESTOR';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasUnit(unitId) {
      return unitId in (getUserData().assignedUnits || []);
    }

    function getRolePermissions(roleId) {
      return get(/databases/$(database)/documents/roles/$(roleId)).data.permissions;
    }

    function hasPermission(module, action) {
      let roleId = getUserData().role;
      let perms = get(/databases/$(database)/documents/roles/$(roleId)).data.permissions;
      return perms[module][action] == true;
    }

    // =================================================================
    // 2. USERS
    // =================================================================
    match /users/{userId} {
      allow create: if isLoggedIn();
      allow read: if isLoggedIn() && (isOwner(userId) || isAdmin() || hasPermission('usuarios', 'read'));
      allow update: if isLoggedIn() && (isOwner(userId) || isAdmin() || hasPermission('usuarios', 'update'));
      allow delete: if isLoggedIn() && isAdmin();

      match /sessions/{sessionId} {
        allow read, write, delete: if isLoggedIn() && isOwner(userId);
      }
    }

    // =================================================================
    // 3. ROLES
    // =================================================================
    match /roles/{roleId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && isAdmin();
    }

    // =================================================================
    // 4. ASSETS
    // =================================================================
    match /assets/{assetId} {
      allow read: if isLoggedIn() && (isAdmin() || hasPermission('ativos', 'read'));
      allow create: if isLoggedIn() && (isAdmin() || hasPermission('ativos', 'create'));
      allow update: if isLoggedIn() && (isAdmin() || hasPermission('ativos', 'update'));
      allow delete: if isLoggedIn() && isAdmin();

      match /history/{historyId} {
        allow read: if isLoggedIn() && (isAdmin() || hasPermission('ativos', 'read'));
        allow create: if isLoggedIn() && (isAdmin() || hasPermission('ativos', 'update'));
      }
    }

    // =================================================================
    // 5. HISTORY (Collection Group for cross-collection queries)
    // NOTE: collectionGroup queries match ANY 'history' collection at any path
    // {path=**} matches zero or more segments (e.g., assets/ABC/history e system_logs/audit/history)
    // =================================================================
    match /{path=**}/history/{historyId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
    }

    // =================================================================
    // 6. UNITS
    // =================================================================
    match /units/{unitId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_unidades', 'create'));
      allow update: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_unidades', 'update'));
      allow delete: if isLoggedIn() && isAdmin();
    }

    // =================================================================
    // 7. ASSET MODELS
    // =================================================================
    match /assetModels/{modelId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_modelos', 'create'));
      allow update: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_modelos', 'update'));
      allow delete: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_modelos', 'delete'));
    }

    // =================================================================
    // 8. SUPPLIERS
    // =================================================================
    match /suppliers/{supplierId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_empresas', 'create'));
      allow update: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_empresas', 'update'));
      allow delete: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_empresas', 'delete'));
    }

    // =================================================================
    // 9. SYSTEM OPTIONS
    // =================================================================
    match /systemOptions/{docId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && (isAdmin() || hasPermission('cadastros_opcoes', 'update') || hasPermission('cadastros_opcoes', 'create'));
    }

    // =================================================================
    // 10. SYSTEM LOGS
    // =================================================================
    match /system_logs/{logType}/{docId} {
      allow read: if isLoggedIn() && (isAdmin() || hasPermission('usuarios', 'read'));
      allow create: if isLoggedIn();
      allow update, delete: if isLoggedIn() && isAdmin();
    }
  }
}